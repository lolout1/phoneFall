<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fall Detection - Phone"
        android:textSize="24sp"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="12dp" />

    <!-- Current configuration display -->

    <!-- Activation status -->
    <TextView
        android:id="@+id/tvCurrentConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Config: ..."
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvActivated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not Activated"
        android:layout_marginTop="8dp" />

    <!-- Stopwatch display -->
    <TextView
        android:id="@+id/tvStopwatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stopwatch: 0 ms" />

    <!-- Prediction label -->
    <TextView
        android:id="@+id/tvPrediction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting..."
        android:textSize="16sp"
        android:layout_marginTop="4dp" />

    <!-- Probability display -->
    <TextView
        android:id="@+id/tvProbability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Probability: -"
        android:layout_marginTop="2dp"
        android:textSize="16sp" />

    <!-- Start and Stop buttons -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STOP"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <!-- View Logs button -->
    <Button
        android:id="@+id/btnViewLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Logs"
        android:layout_marginTop="12dp" />

    <!-- ScrollView for prediction history -->
    <ScrollView
        android:id="@+id/scrollViewPredictions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/tvPredictionsHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </ScrollView>

</LinearLayout>
