<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewConfig"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/configContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvWatchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No watches connected"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
        <!-- TFLite Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select TFLite Model"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerModelFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Device Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Device Mode"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerDeviceMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Sensor Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Sensor Type"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerSensorType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Time Embedding -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Embedding"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerTimeEmbedding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Data Type (Raw vs Linear) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Type"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerDataType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Config"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>