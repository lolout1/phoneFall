<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions for the watch app -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Specify this is a watch app -->
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_alert"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Main watch activity -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".WatchMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watch sensor service -->
        <service android:name=".WatchSensorService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Watch message listener service -->
        <service android:name=".WatchWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/start_on_watch" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/stop_on_watch" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/config_update" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/status_request" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/predict_update" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/phone_command" />
            </intent-filter>
        </service>
    </application>
</manifest>